# Required for any local run. Find it at intervals.icu -> Settings -> Developer Settings.
INTERVALS_API_KEY=

# Everything below is only needed for the remote Fly.io deployment (GitHub OAuth).
# Leave these unset for a local stdio run — the server starts without auth.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# JWT_SIGNING_KEY=          # openssl rand -hex 32
# ALLOWED_GITHUB_USERS=     # comma-separated GitHub usernames
# PUBLIC_BASE_URL=          # e.g. https://your-app-name.fly.dev
